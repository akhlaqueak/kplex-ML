#!/bin/bash

#SBATCH --job-name=serial             ### Name of the job
#SBATCH --ntasks=16                    ### Number of Tasks
#SBATCH --cpus-per-task=1              ### Number of Tasks per CPU
#SBATCH --mem-per-cpu=60G                        ### Memory required, 4 gigabyte
#SBATCH --partition=medium             ### Cheaha Partition
#SBATCH --time=2:00:00                 ### Estimated Time of Completion, 1 hour
#SBATCH --output=%x.out              ### Slurm Output file, %x is job name, %j is job id
#SBATCH --error=%x.err               ### Slurm Error file, %x is job name, %j is job id

srun --label bash -c '
rank=$SLURM_PROCID
nworkers=$SLURM_NTASKS
i=0

while read -r line || [[ -n "$line" ]]; do
    if (( i % nworkers == rank )); then
        echo "[Rank $rank] Task $i: $line"
        ./toBin-fixed BK/$line.txt
        mv BK/$line.bin large-collection/.
        echo "Done... [Rank $rank] Task $i: $line"   
    fi
    ((i++))
done < conv.txt
'
