#!/bin/bash
#SBATCH --job-name=UMKP_batch
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --ntasks=156
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

# ---------------- configuration ----------------
LOGS=test
DATA_DIR="$HOME/graphs/large-collection"
TIME="00:00:10"
MAX_TASKS="${SLURM_NTASKS:-156}"
# -----------------------------------------------

mkdir -p "$LOGS"

# Collect datasets safely (no path, no .bin)
shopt -s nullglob
datasets=()
for f in "$DATA_DIR"/*.bin; do
    datasets+=( "$(basename "$f" .bin)" )
done
shopt -u nullglob

if (( ${#datasets[@]} == 0 )); then
    echo "ERROR: no .bin files found in $DATA_DIR" >&2
    exit 1
fi

krange=(2 3 4 5 6 7 8 9 10 15 20)

# configs CONTAIN program + its own arguments (UNCHANGED)
configs=(
    "UMKP -branching Default-Br"
    # "UMKPEX -algorithm kPEX"
    # "OtherProg --flag X"
)

count=0

# sanitize strings for filenames
sanitize() {
    echo "$*" | sed 's/[[:space:]]\+/_/g; s/[^A-Za-z0-9._-]/_/g'
}

run_task() {
    local args=( "$@" )

    # filename based on full argument list
    local tag
    tag="$(sanitize "${args[*]}")"
    local outfile="$LOGS/${tag}.txt"

    # skip completed runs
    if grep -q ">>" "$outfile" 2>/dev/null || grep -q "Trivial" "$outfile" 2>/dev/null; then
        return
    fi

    # launch ONE Slurm task (1 CPU)
    srun --exclusive -n1 -c1 --time="$TIME" \
         "${args[@]}" > "$outfile" 2>&1 &

    ((count++))

    # throttle to allocated tasks
    while (( count >= MAX_TASKS )); do
        wait -n
        ((count--))
    done
}

# ---------------- launch tasks ----------------
for ds in "${datasets[@]}"; do
    for k in "${krange[@]}"; do
        for cfg in "${configs[@]}"; do
            # split cfg safely into array
            read -r -a base <<< "$cfg"
            run_task "${base[@]}" "${ds}.bin" "$k"
        done
    done
done

wait
echo "All tasks finished at $(date)"

# ---------------- collect results ----------------
rm -f output.txt

for k in "${krange[@]}"; do
    echo "------------- k=$k -------------" >> output.txt
    for ds in "${datasets[@]}"; do
        echo -n "$ds $k" >> output.txt
        for cfg in "${configs[@]}"; do
            read -r -a base <<< "$cfg"
            tag="$(sanitize "${base[*]} ${ds}.bin $k")"
            fname="$LOGS/${tag}.txt"
            awk '/>>/ {printf " %s", $NF; found=1} END{if(!found) printf " x"}' "$fname" >> output.txt
        done
        echo >> output.txt
    done
done

echo "Results written to output.txt"
echo "Job completed at $(date)"
