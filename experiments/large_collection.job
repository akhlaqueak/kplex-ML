#!/bin/bash
#SBATCH --job-name=serial
#SBATCH --ntasks=156
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

LOGS=test
mkdir -p "$LOGS"
DATA_DIR="$HOME/graphs/large-collection"
TIME="00:00:10"

MAX_JOBS="${SLURM_NTASKS:-156}"
count=0

shopt -s nullglob
datasets=()
for f in "$DATA_DIR"/*.bin; do
    datasets+=( "$(basename "$f" .bin)" )
done
shopt -u nullglob

if (( ${#datasets[@]} == 0 )); then
    echo "No datasets found, exiting."
    exit 1
fi

krange=(2 3 4 5 6 7 8 9 10 15 20)

configs=(
   "UMKPEX -algorithm UMKP+ -branching S-Br"
   "UMKPEX -algorithm UMKP+ -branching R-Br"
   "UMKPEX -algorithm UMKP+ -branching Pivot-Br"
   "UMKPEX -algorithm kPEX"
   "UMKPEX -algorithm kPEX -branching S-Br"
   "UMKPEX -algorithm kPEX -branching R-Br"
   "UMKPEX -algorithm kPEX -branching Pivot-Br"
   "UMKP -branching S-Br"
   "UMKP -branching R-Br"
   "UMKP -branching Pivot-Br"
)

configs=("UMKP -branching Default-Br")
sanitize() {
    echo "$*" | sed 's/[[:space:]]\+/_/g; s/[^A-Za-z0-9._-]/_/g'
}

run_with_output() {
    local prog="$1"; shift
    local args=( "$@" )

    local tag
    tag="$(sanitize "${prog} ${args[*]}")"
    local outfile="$LOGS/${tag}.txt"

    if ! ( grep -q ">>" "$outfile" 2>/dev/null || grep -q "Trivial" "$outfile" 2>/dev/null ); then
        srun --exclusive -n1 -c1 --time="$TIME" "$prog" "${args[@]}" > "$outfile" 2>&1 &
        ((count++))
    fi

    # PORTABLE throttling (no wait -n)
    while (( count >= MAX_JOBS )); do
        sleep 1
        count=$(jobs -r | wc -l)
    done
}

for ds in "${datasets[@]}"; do
    for k in "${krange[@]}"; do
        for c in "${configs[@]}"; do
            read -r -a base <<< "$c"
            run_with_output "${base[@]}" "$DATA_DIR/${ds}.bin" "$k"
        done
    done
done

wait
echo "Job finished at $(date)"
