#!/bin/bash

#SBATCH --job-name=serial             ### Name of the job
#SBATCH --ntasks=192                    ### Number of Tasks
#SBATCH --cpus-per-task=1              ### Number of Tasks per CPU
#SBATCH --mem-per-cpu=10G                        ### Memory required, 4 gigabyte
#SBATCH --partition=medium             ### Cheaha Partition
#SBATCH --time=2:00:00                 ### Estimated Time of Completion, 1 hour
#SBATCH --output=%x.out              ### Slurm Output file, %x is job name, %j is job id
#SBATCH --error=%x.err               ### Slurm Error file, %x is job name, %j is job id

MAX_JOBS=1800
count=0
LOG=test-10-sec
mkdir $LOG
run_with_output() {
    prog="$1"     # first argument is the program name
    shift         # remove program name from the list
    outfile="$LOG/$(IFS=_; echo "$*").txt"
    if ! grep -q ">>" "$outfile" && ! grep -q "Warning" "$outfile"; then
        srun --nodes=1 --ntasks=1 -c 1 --time=00:00:10 --unbuffered --exclusive ./$prog ~/graphs/large-collection/$* > $outfile 2>&1 &    
        ((count++))
    fi
}
run_jobs() {
    for ds in $datasets; do
        for k in $krange; do
            for c in "${configs[@]}"; do
                if grep -Eq "Small|Preprocessing" test-prep-small/"$ds.bin_$k"; then
                    continue
                fi

                [[ -f $LOG/$ds.bin_$k_UMKP ]] && continue;
                read -r first rest <<< "$c"
                c="$first $ds.bin $k $rest"
                run_with_output $c
                # If at concurrency limit, wait for *one* job to finish
                while (( count >= MAX_JOBS )); do
                    wait
                    count=0
                done

            done
        done
    done

    wait  # wait for remaining sruns to complete
}

# datasets=$(ls ~/graphs/large-collection/*.bin | xargs -n1 basename -s .bin)
datasets=$(< datas.txt)
krange='2 3 4 5 6 7 8 9 10 15 20'
# krange='2'
configs=(
    "UMKP -branching Default-Br"
    "UMKPEX -branching Binary-Br"
#    "UMKP -branching S-Br" 
#    "UMKP -branching R-Br" 
#    "UMKP -branching Pivot-Br"
#    "UMKPEX -algorithm UMKP+ -branching S-Br"
#    "UMKPEX -algorithm UMKP+ -branching R-Br"
#    "UMKPEX -algorithm UMKP+ -branching Pivot-Br"
#    "UMKPEX -algorithm kPEX"
#    "UMKPEX -algorithm kPEX -branching S-Br"
#    "UMKPEX -algorithm kPEX -branching R-Br"
#    "UMKPEX -algorithm kPEX -branching Pivot-Br"
)
run_jobs

output=output.txt
get_results() {
    rm $output
    for k in $krange; do
        # echo " -------------k=$k-----------------" >> $output
        for ds in $datasets; do
            echo -en "${ds/.bin} $k " >> $output

            results=()   # array to store values
            prep=false
            for c in "${configs[@]}"; do
                if grep -Eq "Small|Preprocessing" test-prep-small/"$ds.bin_$k"; then
                    prep=true
                    break
                fi
                read -r first rest <<< "$c"
                c="$ds.bin $k${rest:+ $rest}"
                outfile="$LOG/${c// /_}.txt"

                value=$(awk '/>>/ {printf " %s", $NF; found=1} END{if(!found) printf "x"}' "$outfile")
                results+=("$value")
            done

            if $prep; then
                echo "prep-solved" >> $output
                continue
            fi

            all_lt_1=true
            all_x=true

            for v in "${results[@]}"; do
                if [[ "$v" != "x" ]]; then
                    all_x=false
                    # numeric check
                    if (( $(echo "$v >= 1" | bc -l) )); then
                        all_lt_1=false
                        break
                    fi
                else
                    all_lt_1=false
                fi
            done

            if $all_lt_1; then
                echo "subsecond-solved" >> $output
                continue
            fi
            if $all_x; then
                echo  "not-solved" >> $output
                continue
            fi

            echo "practical ${results[@]}" >> $output
        done
    done

}
# get_results

output=prep.txt
get_results() {
    rm $output
        # echo " -------------k=$k-----------------" >> $output
    for ds in $datasets; do
        echo -en "${ds/.bin} " >> $output
        for k in $krange; do
            outfile="test-prep-small/$ds.bin_$k"
            results=()   # array to store values
            prep=false
            if grep -Eq "Small|Preprocessing" $outfile; then    
                echo -en " prep" >> $output
                continue
            fi
            value=$(awk '/>>/ {printf " %s", $NF; found=1} END{if(!found) printf "x"}' "$outfile")
            echo -en " $value" >> $output

        done
        echo >> $output
    done

}
# get_results 

echo "Job finished at $(date)"
