#!/bin/bash
#SBATCH --job-name=UMKP_batch
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=156
#SBATCH --mem-per-cpu=10G
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

# ------------------ configuration ------------------
MAX_JOBS=156                 # number of parallel tasks
TIME=00:00:10
LOGS=test
DATA_DIR="$HOME/graphs/large-collection"
PROG="./UMKP"
# ---------------------------------------------------

mkdir -p "$LOGS"

# Collect datasets safely (no extension, no path)
datasets=()
for f in "$DATA_DIR"/*.bin; do
    datasets+=( "$(basename "$f" .bin)" )
done

krange=(2 3 4 5 6 7 8 9 10 15 20)

configs=(
    "UMKP -branching Default-Br"
)

count=0

run_task() {
    local prog="$1"; shift
    local args=("$@")

    local outfile="$LOGS/$(printf '%s_' "${args[@]}" | sed 's/_$//').txt"

    # Skip if already completed
    if grep -q ">>" "$outfile" 2>/dev/null || grep -q "Trivial" "$outfile" 2>/dev/null; then
        return
    fi

    srun --exclusive -n1 -c1 --time="$TIME" \
         "$prog" "${args[@]}" > "$outfile" 2>&1 &

    ((count++))

    # throttle to MAX_JOBS
    while (( count >= MAX_JOBS )); do
        wait -n
        ((count--))
    done
}

# ------------------ launch tasks ------------------
for ds in "${datasets[@]}"; do
    for k in "${krange[@]}"; do
        for cfg in "${configs[@]}"; do
            read -r prog rest <<< "$cfg"
            run_task "$PROG" "$ds.bin" "$k" $rest
        done
    done
done

wait
echo "All tasks completed at $(date)"

# ------------------ collect results ------------------
rm -f output.txt

for k in "${krange[@]}"; do
    echo "------------- k=$k -------------" >> output.txt
    for ds in "${datasets[@]}"; do
        echo -n "$ds $k" >> output.txt
        for cfg in "${configs[@]}"; do
            read -r _ rest <<< "$cfg"
            fname="$LOGS/${ds}.bin_${k}${rest:+_$rest}.txt"
            awk '/>>/ {printf " %s", $NF; found=1} END{if(!found) printf " x"}' "$fname" >> output.txt
        done
        echo >> output.txt
    done
done

echo "Results written to output.txt"
echo "Job finished at $(date)"
