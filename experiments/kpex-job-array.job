#!/bin/bash
#SBATCH -J massive_array_run
#SBATCH -n 192                     # 192 total CPUs (threads)
#SBATCH -c 1                       # 1 CPU per task
#SBATCH -t 00:10:00                # each job runs for up to 10 minutes
#SBATCH --mem=10G                  # 10 GB per process
#SBATCH -a 1-85755%192             # 85,755 total, 192 concurrent
#SBATCH --output=logs-array/array-%A_%a.out
#SBATCH --error=logs-array/array-%A_%a.err

module load openmpi
mkdir -p logs-array

CMD=$(sed -n "${SLURM_ARRAY_TASK_ID}p" config.txt)
[[ -z "$CMD" ]] && { echo "Empty line for task $SLURM_ARRAY_TASK_ID"; exit 0; }

echo "[Task $SLURM_ARRAY_TASK_ID on $(hostname)] running: $CMD"

# Run each command directly; Slurm already applies 10-min limit per array task
bash -c "$CMD"
