#!/bin/bash
#SBATCH --job-name=serial
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=6G
#SBATCH --partition=medium
#SBATCH --time=2:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

######################################
# Paths / files
######################################

LOG="test-1m"
TASKFILE="tasks.txt"
CONFIGFILE="configs.txt"
TIME=1m
mkdir -p "$LOG"

######################################
# Datasets / parameters
######################################
datasets=$(< datas.txt)
krange='2 3 4 5 6 7 8 9 10 15 20'

configs=(
    "UMKP -branching Default-Br"
    "UMKPEX -branching Binary-Br"
)

######################################
# Build TASKFILE
######################################

: > "$TASKFILE"

for ds in $datasets; do
    for k in $krange; do
        if grep -Eq "Small|Preprocessing" "test-prep-small/${ds}.bin_${k}" 2>/dev/null; then
            continue
        fi


        echo "$ds $k" >> "$TASKFILE"
    done
done

echo "Total tasks: $(wc -l < "$TASKFILE")"

######################################
# Write CONFIGFILE
######################################

: > "$CONFIGFILE"
for c in "${configs[@]}"; do
    echo "$c" >> "$CONFIGFILE"
done

######################################
# Worker function
######################################

run_with_output() {
    local ds="$1"
    local k="$2"

    while IFS= read -r c || [[ -n "$c" ]]; do
        read -r prog rest <<< "$c"

        outfile="$LOG/$ds.bin $k $rest.txt"
        outfile=${outfile// /_}
        timeout $TIME "./$prog" \
            "$HOME/graphs/large-collection/${ds}.bin" \
            "$k" \
            $rest \
            > "$outfile" 2>&1 || true
    done < "$CONFIGFILE"
}

export -f run_with_output
export LOG CONFIGFILE

######################################
# ONE srun – rank-based work sharing
######################################

srun bash -c '
rank=$SLURM_PROCID
nworkers=$SLURM_NTASKS
i=0

while read -r ds k || [[ -n "$ds" ]]; do
    if (( i % nworkers == rank )); then
        run_with_output "$ds" "$k"
    fi
    ((i++))
done < "'"$TASKFILE"'"
'
