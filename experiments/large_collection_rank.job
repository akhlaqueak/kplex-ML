#!/bin/bash
#SBATCH --job-name=serial
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=6G
#SBATCH --partition=medium
#SBATCH --time=24:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

######################################
# Paths / files
######################################

LOG="test-1m"
TASKFILE="tasks.txt"
TIME=1m
mkdir -p "$LOG"

######################################
# Datasets / parameters
######################################

datasets=$(< datas.txt)
krange='2 3 4 5 6 7 8 9 10 15 20'

configs=(
  "UMKP|-branching S-Br"
  "UMKP|-branching R-Br"
  "UMKP|-branching Pivot-Br"
  "UMKPEX|-algorithm UMKP+ -branching S-Br"
  "UMKPEX|-algorithm UMKP+ -branching R-Br"
  "UMKPEX|-algorithm UMKP+ -branching Pivot-Br"
  "UMKPEX|-algorithm kPEX"
  "UMKPEX|-algorithm kPEX -branching S-Br"
  "UMKPEX|-algorithm kPEX -branching R-Br"
  "UMKPEX|-algorithm kPEX -branching Pivot-Br"
)

######################################
# Build TASKFILE
# Format per line:
# prog ds k args...
######################################

: > "$TASKFILE"

for ds in $datasets; do
    for k in $krange; do
        if grep -Eq "Small|Preprocessing" "test-prep-small/${ds}.bin_${k}" 2>/dev/null; then
            continue
        fi

        for c in "${configs[@]}"; do
            IFS='|' read -r prog args <<< "$c"
            
            outfile="$LOG/$prog $ds.bin $k $args.txt"
            outfile=${outfile// /_}

            grep -q ">>" "$outfile" 2>/dev/null && continue

            echo "$prog $ds $k $args" >> "$TASKFILE"
        done
    done
done

echo "Total tasks: $(wc -l < "$TASKFILE")"

######################################
# Worker function
# Receives the entire task line
######################################

run_one_task() {
    local line="$1"

    # Parse: prog ds k args...
    read -r prog ds k args <<< "$line"

    outfile="$LOG/$prog $ds.bin $k $args.txt"
    outfile=${outfile// /_}

    timeout 10m "./$prog" \
        "$HOME/graphs/large-collection/${ds}.bin" \
        "$k" \
        $args \
        > "$outfile" 2>&1 || true
}

export -f run_one_task
export LOG

######################################
# ONE srun – rank-based work sharing
######################################

echo "starting at" "$(date)"

srun --label bash -c '
rank=$SLURM_PROCID
nworkers=$SLURM_NTASKS
i=0

while read -r line || [[ -n "$line" ]]; do
    if (( i % nworkers == rank )); then
        echo "[Rank $rank] Task $i: $line"
        run_one_task "$line"
    fi
    ((i++))
done < "'"$TASKFILE"'"
'

echo "finished at" "$(date)"

# compile output
get_results() {
output=ds1m.out
rm $output
for ds in $datasets; do
    for k in $krange; do
        echo -en "$ds $k" >> $output


        for c in "${configs[@]}"; do
            if grep -Eq "Small|Preprocessing" "test-prep-small/${ds}.bin_${k}" 2>/dev/null; then
                echo -en " prep" >> $output
                continue
            fi
            IFS='|' read -r prog args <<< "$c"
            
            outfile="$LOG/$prog $ds.bin $k $args.txt"
            outfile=${outfile// /_}
            
            value=$(awk '/>>/ {printf " %s", $NF; found=1} END{if(!found) printf " x"}' "$outfile")
            echo -en " $value" >> $output

        done
        echo >> $output
    done
done
}
# get_results