#!/usr/bin/env bash
#SBATCH --job-name=serial1
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.%A_%a.out
#SBATCH --error=%x.%A_%a.err

# Exit on undefined variables, pipefail, but don't exit on non-zero srun (we handle that)
set -euo pipefail

######################################
# Configurable paths / parameters
######################################
LOG="test-1m"
TASKFILE="filtered_tasks.txt"          # file with one task per line: prog ds k [args...]
FILTERED_DS="filtered-ds.txt"          # used by get_results_filtered
TIME="30m"                             # timeout for each task
mkdir -p "$LOG"

######################################
# Dataset/parameters (example placeholders)
######################################
krange='2 3 4 5 6 7 8 9 10 15 20'
datasets=$(< datasets.txt)             # existing in your environment

configs=(
  "UMKP|-branching S-Br"
  "UMKP|-branching R-Br"
  "UMKP|-branching Pivot-Br"
  "UMKPEX|-algorithm UMKP+ -branching S-Br"
  "UMKPEX|-algorithm UMKP+ -branching R-Br"
  "UMKPEX|-algorithm UMKP+ -branching Pivot-Br"
  "UMKPEX|-algorithm kPEX"
  "UMKPEX|-algorithm kPEX -branching S-Br"
  "UMKPEX|-algorithm kPEX -branching R-Br"
  "UMKPEX|-algorithm kPEX -branching Pivot-Br"
)

######################################
# Debug/log header
######################################
echo "Job started at $(date)"
echo "SLURM job id: ${SLURM_JOB_ID:-local}, array/task id: ${SLURM_ARRAY_TASK_ID:-none}"
echo "Using TASKFILE=$TASKFILE, LOG=$LOG"

######################################
# Worker function (local to this script)
# Accepts one line: prog ds k [args...]
######################################
run_one_task() {
    local line="$1"

    # Parse first three whitespace tokens, remainder into rest
    # Works even when args contain spaces
    local prog ds k rest
    read -r prog ds k rest <<< "$line"

    # Convert rest to array so we can pass as arguments safely
    local -a argarr=()
    if [[ -n "$rest" ]]; then
        # split on whitespace (preserving quoting not supported here)
        # If you need embedded quoted args, change TASKFILE format or use another delimiter.
        read -r -a argarr <<< "$rest"
    fi

    # prepare output filename (replace spaces with _)
    local outfile="$LOG/$prog $ds.bin $k ${rest}.txt"
    outfile=${outfile// /_}

    # run program with timeout; swallow non-zero exit so worker keeps going
    # Use "$@" expansion to correctly pass multiple args
    timeout "$TIME" "./$prog" \
        "$HOME/graphs/large-collection/${ds}.bin" \
        "$k" \
        "${argarr[@]}" \
        > "$outfile" 2>&1 || true

    printf '%s\n' "Executed for $TIME" >> "$outfile"
}

######################################
# Export function if using srun's -c bash -c (not needed for current pattern)
######################################
export -f run_one_task

######################################
# Postprocessing functions
######################################

get_results_filtered() {
    local output="results-filtered-dataset.txt"
    rm -f "$output"

    # If FILTERED_DS file doesn't exist, warn and return
    if [[ ! -f "$FILTERED_DS" ]]; then
        echo "Warning: $FILTERED_DS not found; skipping get_results_filtered"
        return 0
    fi

    while read -r ds k; do
        printf "%s %s" "$ds" "$k" >> "$output"

        local prep=false
        if grep -Eq "Small|Preprocessing" "test-prep-small/${ds}.bin_${k}" 2>/dev/null; then
            prep=true
        fi

        for c in "${configs[@]}"; do
            if $prep; then
                printf " p" >> "$output"
                continue
            fi
            IFS='|' read -r prog args <<< "$c"
            outfile="$LOG/$prog $ds.bin $k $args.txt"
            outfile=${outfile// /_}

            # Extract last >> value if present; else " x"
            value=$(tail -n 5 "$outfile" 2>/dev/null | awk '/^>>/ {print " " $NF; found=1} END{if(!found) print " x"}')
            printf "%s" "$value" >> "$output"
        done
        printf "\n" >> "$output"
    done < "$FILTERED_DS"

    echo "Wrote $output"
}

# Ensure postprocessing runs even if the script exits early
# But avoid running it concurrently from many ranks: check for main process
# We'll run final processing only on the job leader (rank 0) or when not using srun
_run_postprocess_if_leader() {
    # If SLURM_PROCID is set, prefer that; else use 0
    local procid=${SLURM_PROCID:-0}
    if [[ "$procid" -eq 0 ]]; then
        echo "Postprocessing started by proc $procid at $(date)"
        get_results_filtered
        echo "Postprocessing finished at $(date)"
    else
        echo "Proc $procid skipping postprocessing"
    fi
}

trap '_run_postprocess_if_leader' EXIT

######################################
# Main parallel execution using srun with stride (each rank reads only its tasks)
######################################

# If TASKFILE missing or empty, exit gracefully
if [[ ! -s "$TASKFILE" ]]; then
    echo "No tasks in $TASKFILE (missing or empty). Exiting."
    exit 0
fi

# Use srun to launch ranks which will each read only their assigned lines
# Make srun non-fatal to the outer script, so even if some ranks fail, script continues
srun --label bash -c '
rank=${SLURM_PROCID:-0}
nworkers=${SLURM_NTASKS:-1}
taskfile="'"$TASKFILE"'"

sed -n "$((rank+1))~$nworkers p" "$taskfile" |
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line// /}" ]] && continue

    echo "[Rank $rank] Started task: $line"

    read -r prog ds k rest <<< "$line"

    argarr=()
    [[ -n "$rest" ]] && read -r -a argarr <<< "$rest"

    outfile="'"$LOG"'/${prog} ${ds}.bin ${k} ${rest}.txt"
    outfile=${outfile// /_}

    if [[ ! -f "$outfile" ]] || ! grep -q "^>>" "$outfile"; then
        timeout "'"$TIME"'" "./${prog}" "'"$HOME"'/graphs/large-collection/${ds}.bin" \
            "$k" "${argarr[@]}" > "$outfile" 2>&1 || true
        printf "%s\n" "Executed for '"$TIME"'" >> "$outfile"
    fi

    echo "[Rank $rank] Completed task: $line"
done
' || true

echo "srun completed (or returned non-zero but ignored)."

# Main script will exit here; trap will run postprocessing on proc 0
echo "Main script finished at $(date)"
