#!/bin/bash

#SBATCH --job-name=serial             ### Name of the job
#SBATCH --ntasks=48                    ### Number of Tasks
#SBATCH --cpus-per-task=1              ### Number of Tasks per CPU
#SBATCH --mem-per-cpu=10G                        ### Memory required, 4 gigabyte
#SBATCH --partition=medium             ### Cheaha Partition
#SBATCH --time=00:20:00                 ### Estimated Time of Completion, 1 hour
#SBATCH -a 1-10000%48
#SBATCH --output=array-%A_%a.out
#SBATCH --error=array-%A_%a.err
# Load any required modules (e.g. MPI library)
module load openmpi

# Each array task reads its corresponding line from config.txt
CMD=$(sed -n "${SLURM_ARRAY_TASK_ID}p" config.txt)

echo "[Task ${SLURM_ARRAY_TASK_ID} on $(hostname)] Running: $CMD"

# Use srun to launch the command as a proper Slurm step under MPI control
srun --mpi=pmix_v4 -n 1 bash -c "$CMD"

echo "[Task ${SLURM_ARRAY_TASK_ID}] Completed at $(date)"