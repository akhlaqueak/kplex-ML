#!/usr/bin/env bash
#SBATCH --job-name=v2
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=24:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

module load OpenMPI
module load mpi4py

set -euo pipefail


SECONDS=0

cp -f ../UMKPEX .
echo "Job started at $(date)"

# ---- LAUNCH ONLY ----
srun --mpi=pmix --cpu-bind=cores python3 -u mpi_dynamic.py "something"

echo "Job finished at $(date)"
echo "Job completed in $((SECONDS/3600))h $((SECONDS%3600/60))m"
