#!/usr/bin/env bash
#SBATCH --job-name=v0v4
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=48:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

module load OpenMPI
module load mpi4py

set -euo pipefail

# Avoid the UCX/UCT BTL that crashed during MPI_Init, but keep the
# cluster's default transport selection otherwise.
export OMPI_MCA_btl="^uct"
SECONDS=0

mkdir -p logs
cp -f ../UMKPEX .
echo "Job started at $(date)"
python3 -c "from mpi4py import MPI; print(MPI.Get_library_version().strip())" || true
# ---- LAUNCH ONLY ----
srun --mpi=pmix --cpu-bind=cores python3 -u mpi_dynamic.py

echo "Job finished at $(date)"
echo "Job completed in $((SECONDS/3600))h $((SECONDS%3600/60))m"
