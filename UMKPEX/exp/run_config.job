#!/usr/bin/env bash
#SBATCH --job-name=task-runner
#SBATCH --ntasks=216
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=36:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail


######################################
# USER INPUT (ONLY THIS)
######################################
TASKFILE="tasks.txt"        # each line = full command to execute
TASK_TIMEOUT="30m"           # timeout per task (e.g. 300s, 10m, 1h)
TIMEOUT_GRACE="30s"         # grace period before SIGKILL
DS_LOC="/home/akhlaque.ak@gmail.com/graphs/large-collection"
create_tasks(){
    rm -f $TASKFILE
    BR='S-Br R-Br Pivot-Br'
    while read -r ds k; do 
        for heur in kPEX-Heur EGO-Heur; do
            for br in $BR; do 
                for ct in CTCP CF-CTCP; do
                    cmd="UMKPEX $DS_LOC/$ds.bin $k -branching $br -heuristic $heur -algorithm kPEX -ctcp $ct"
                    echo "$cmd" >> "$TASKFILE"
                done
            done
        done
    done < ../ds.txt
}
create_tasks

# get_results(){
#     while read -r ds k; do 
#         for prog in UMKP UMKP-S UMKP-R UMKP-P; do
#             fname=$(echo "$prog $ds $k" | tr ' ' '_')
#             if grep -q ">>" "$fname"; then
