#!/usr/bin/env bash
#SBATCH --job-name=task-runner
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail


######################################
# USER INPUT (ONLY THIS)
######################################
TASKFILE="tasks.txt"        # each line = full command to execute
TASK_TIMEOUT="30m"           # timeout per task (e.g. 300s, 10m, 1h)
TIMEOUT_GRACE="30s"         # grace period before SIGKILL
DS_LOC="/home/akhlaque.ak@gmail.com/graphs/large-collection"
    create_tasks(){
        rm $TASKFILE
        BR='S-Br R-Br Pivot-Br'
        while read -r ds k; do 

            for br in $BR; do 
                # cmd="UMKPEX-CTCP $DS_LOC/$ds.bin $k -algorithm UMKP+ -branching $br"
                # grep -q "${ds}_${k}_${br}_v1" task-runner.out || { echo "./$cmd > ${ds}_${k}_${br}_v1" >> "$TASKFILE"; }
                # # grep -q "${ds}_${k}_${br}_v2" || echo "./$cmd > ${ds}_${k}_${br}_v1" >> $TASKFILE

                # cmd="UMKPEX-CTCP $DS_LOC/$ds.bin $k -algorithm UMKP+ -branching $br -bounding AltRB -heuristic EGO-Heur"
                # # echo "./$cmd > ${ds}_${k}_${br}_v2" >> $TASKFILE
                # grep -q "${ds}_${k}_${br}_v2" task-runner.out || { echo "./$cmd > ${ds}_${k}_${br}_v2" >> "$TASKFILE"; }

                # cmd="UMKPEX $DS_LOC/$ds.bin $k -algorithm UMKP+ -branching $br -heuristic EGO-Heur"
                # # echo "./$cmd > ${ds}_${k}_${br}_v3" >> $TASKFILE
                # grep -q "${ds}_${k}_${br}_v3" task-runner.out || { echo "./$cmd > ${ds}_${k}_${br}_v3" >> "$TASKFILE"; }

                # cmd="UMKPEX $DS_LOC/$ds.bin $k -algorithm UMKP+ -branching $br"
                # # echo "./$cmd > ${ds}_${k}_${br}_v4" >> $TASKFILE
                # grep -q "${ds}_${k}_${br}_v4" task-runner.out || { echo "./$cmd > ${ds}_${k}_${br}_v4" >> "$TASKFILE"; }


                # cmd="UMKPEX-CTCP $DS_LOC/$ds.bin $k -algorithm UMKP+ -branching $br -bounding AltRB"
                # echo "./$cmd > ${ds}_${k}_${br}_v6" >> $TASKFILE
                # grep -q "${ds}_${k}_${br}_v5" task-runner.out || { echo "./$cmd > ${ds}_${k}_${br}_v5" >> "$TASKFILE"; }

                cmd="UMKPEX-CTCP $DS_LOC/$ds.bin $k -algorithm UMKP+ -branching $br -heuristic EGO-Heur"
                echo "./$cmd > ${ds}_${k}_${br}_v6" >> $TASKFILE
                # grep -q "${ds}_${k}_${br}_v2" task-runner.out || { echo "./$cmd > ${ds}_${k}_${br}_v2" >> "$TASKFILE"; }

