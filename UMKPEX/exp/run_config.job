######################################
# USER-MODIFIABLE FUNCTION
######################################
run_task() {
    local cmd="$1"

    echo "START $(date) :: $cmd"

    set -- $cmd
    full_cmd=("$@")   # save everything

    file="$2"
    base=$(basename "$file")
    base="${base%.*}"

    outfile="${1}_${base}"

    # build filename from filtered args
    shift 2
    for arg in "$@"; do
        if [[ "$arg" != -* ]]; then
            outfile="${outfile}_${arg}"
        fi
    done

    outfile=$(echo "$outfile" | tr ' ' '_')
    outfile="${outfile}.log"

    # run FULL command
    timeout --signal=TERM \
            --kill-after="$TIMEOUT_GRACE" \
            "$TASK_TIMEOUT" \
            "./${full_cmd[@]}" > "$outfile" 2>&1
    rc=$?

    case $rc in
        0)
            echo "SUCCESS  $cmd"
            ;;
        124)
            echo "TIMEOUT  $cmd" >> "$outfile"
            ;;
        137)
            echo "KILLED  $cmd" >> "$outfile"
            ;;
        *)
            echo "FAILED  $cmd (exit=$rc)" >> "$outfile"
            ;;
    esac

    # 🔑 NEVER allow failure to stop the rank
    return 0
}

# 🔑 REQUIRED: export function and variables for worker shells
export -f run_task
export TASKFILE TASK_TIMEOUT TIMEOUT_GRACE

######################################
# Sanity checks
######################################
if [[ ! -s "$TASKFILE" ]]; then
    echo "Task file '$TASKFILE' is missing or empty"
    exit 1
fi

echo "Job started at $(date)"
echo "Task file: $TASKFILE"
echo "Timeout per task: $TASK_TIMEOUT"
echo "SLURM job id: ${SLURM_JOB_ID:-local}"

######################################
# Parallel execution
######################################
srun --label bash -c '
# IMPORTANT: do NOT use set -e here
set -o pipefail

cd "$SLURM_SUBMIT_DIR" || exit 1

rank=${SLURM_PROCID:-0}
nworkers=${SLURM_NTASKS:-1}

# Distribute tasks by stride
sed -n "$((rank+1))~$nworkers p" "$TASKFILE" |
while IFS= read -r cmd || [[ -n "$cmd" ]]; do
    # Skip empty lines and comments
    [[ -z "${cmd//[[:space:]]/}" ]] && continue
    [[ "${cmd## }" == \#* ]] && continue

    echo "[Rank $rank] Running: $cmd"

    run_task "$cmd"
done
'

echo "Job finished at $(date)"

get_results
