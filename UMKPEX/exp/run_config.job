    }
# create_tasks
get_results(){
    outfile=output.txt
    rm $outfile
    BR='S-Br R-Br Pivot-Br'
    while read -r ds k; do 
    for ver in v5; do 
        for br in $BR; do 
            fname="${ds}_${k}_${br}_$ver"
            val="x"

            if [[ -f "$fname" ]]; then
                mapfile -tn 0 line < "$fname"
                last="${line[-1]}"
                if [[ $last == ">>"* ]]; then
                    tmp=${last#>>}
                    read -ra parts <<< "$tmp"
                    val=${parts[-1]}
                fi
            fi

            printf "%s " "$val" >> $outfile
        done
    done
    echo >> $outfile
    done < ../ds.txt
}
get_results(){
    while read -r ds k; do 
        for prog in UMKP UMKP-S UMKP-R UMKP-P; do
            fname=$(echo "$prog $ds $k" | tr ' ' '_')
            if grep -q ">>" "$fname"; then
                val=$(grep ">>" "$fname" | awk '{print $NF}')
            else
                val="x"
            fi
            printf "%s " "$val" >> output.txt
        done
        printf "\n" >> output.txt
    done < ../ds.txt
}
######################################
# USER-MODIFIABLE FUNCTION
######################################
run_task() {
    local cmd="$1"

    echo "START $(date) :: $cmd"

    timeout --signal=TERM \
            --kill-after="$TIMEOUT_GRACE" \
            "$TASK_TIMEOUT" \
            bash -c "$cmd"
    rc=$?

    case $rc in
        0)
            echo "DONE  $(date) :: success"
            ;;
        124)
            echo "DONE  $(cmd) :: TIMEOUT"
            ;;
        137)
            echo "DONE  $(cmd) :: KILLED"
            ;;
        *)
            echo "DONE  $(cmd) :: FAILED (exit=$rc)"
            ;;
    esac

    # 🔑 NEVER allow failure to stop the rank
    return 0
}

# 🔑 REQUIRED: export function and variables for worker shells
export -f run_task
export TASKFILE TASK_TIMEOUT TIMEOUT_GRACE

######################################
# Sanity checks
######################################
if [[ ! -s "$TASKFILE" ]]; then
    echo "Task file '$TASKFILE' is missing or empty"
    exit 1
fi

echo "Job started at $(date)"
echo "Task file: $TASKFILE"
echo "Timeout per task: $TASK_TIMEOUT"
echo "SLURM job id: ${SLURM_JOB_ID:-local}"

######################################
# Parallel execution
######################################
srun --label bash -c '
# IMPORTANT: do NOT use set -e here
set -o pipefail

cd "$SLURM_SUBMIT_DIR" || exit 1

rank=${SLURM_PROCID:-0}
nworkers=${SLURM_NTASKS:-1}

# Distribute tasks by stride
sed -n "$((rank+1))~$nworkers p" "$TASKFILE" |
while IFS= read -r cmd || [[ -n "$cmd" ]]; do
    # Skip empty lines and comments
    [[ -z "${cmd//[[:space:]]/}" ]] && continue
    [[ "${cmd## }" == \#* ]] && continue

    echo "[Rank $rank] Running: $cmd"

    run_task "$cmd"
done
'

echo "Job finished at $(date)"
