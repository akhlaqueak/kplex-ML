#!/bin/bash

#SBATCH --job-name=serial             ### Name of the job
#SBATCH --ntasks=64                    ### Number of Tasks
#SBATCH --cpus-per-task=1              ### Number of Tasks per CPU
#SBATCH --mem-per-cpu=6000                        ### Memory required, 4 gigabyte
#SBATCH --partition=medium             ### Cheaha Partition
#SBATCH --time=10:00:00                 ### Estimated Time of Completion, 1 hour
#SBATCH --output=%x.out              ### Slurm Output file, %x is job name, %j is job id
#SBATCH --error=%x.err               ### Slurm Error file, %x is job name, %j is job id
#SBATCH --mail-type=END
#SBATCH --mail-user=akhlaque.ak@gmail.com
run_with_output() {
    prog="$1"     # first argument is the program name
    shift         # remove program name from the list
    outfile="$(IFS=_; echo "$*").txt"
    srun --unbuffered --nodes=1 --ntasks=1 -c 1 --time=30m --exclusive $prog $1 $2 -algorithm $3 -branching $4 > $outfile 2>&1 &
}

run_jobs() {
    # for kplex in $solutions; do
    for ds in $datasets; do
        for k in $krange; do
            for br in $branchings; do
                for alg in $algorithms; do
                    run_with_output ./kPEX $ds $k $alg $br
                done
            done
        done
    done
    wait
}

datasets='brock200-2.bin        keller4.bin                    sc-ldoor.bin      soc-lastfm.bin                   soc-youtube-snap.bin
dbpedia-link.bin      MANN-a45.bin                   sc-msdoor.bin     soc-livejournal-user-groups.bin  sx-stackoverflow.bin
delicious-ui.bin      MANN-a81.bin                   soc-bitcoin.bin   soc-LiveMocha.bin                tech-ip.bin
dimacs9-CTR.bin       p-hat500-1.bin                 soc-buzznet.bin   soc-orkut.bin                    trackers.bin
dimacs9-USA.bin       p-hat700-1.bin                 soc-digg.bin      soc-pokec.bin                    web-ClueWeb09.bin
hamming6-2.bin        readme.html                    socfb-A-anon.bin  soc-sinaweibo.bin                web-wikipedia_link_it.bin
ia-wiki-Talk.bin      rec-epinions-user-ratings.bin  socfb-B-anon.bin  wikipedia-link-en13.bin
ia-wiki-Talk-dir.bin  san200-0-9-1.bin               socfb-Duke14.bin  soc-themarker.bin                wikipedia-link-en.bin
johnson8-4-4.bin      san200-0-9-2.bin               soc-gowalla.bin   soc-youtube.bin'
krange='2 3 4 5 6 7 8 9 10 15 20'
algorithms='kPEX UMKP'
branchings='Default-Br S-Br R-Br SR-Br'
run_jobs


    get_results() {
        result=results.out
        rm $result
        echo -en "," >>$result
        WORD_COUNT=$(echo "$solutions" | wc -w)
        for k in $krange; do
            echo -en "**k=$k**," >>$result
            for ((i = 1; i < $WORD_COUNT; i++)); do
                echo -en "," >>$result
            done
            # echo -en "|," >>$result
        done
        echo >>$result

        echo -en "datasets," >>$result
        for k in $krange; do
            for sol in $solutions; do
                echo -en "${sol#*-}," >>$result
            done
            # echo -en "|," >>$result
        done
        echo >>$result

        for fn in $datasets; do
            # echo -en "$fn," >>$result
            for k in $krange; do

                line=()
                outfile=''
                for sol in $solutions; do
                    outfile=$fn-$sol-$k.out
                    op=$(grep ">>" $outfile | head -1)
                    if [ -z "${op}" ]; then
                        line+=('9999999999')
                    else
                        op=($op)
                        line+=(${op[-3]})
                    fi
                done
                m=$(printf "%s\n" "${line[@]}" | sort -rn | tail -n1)
                secm=$(printf "%s\n" "${line[@]}" | sort -rn | tail -n2 | head -n1)
                echo ${line[@]}
                for i in "${line[@]}"; do
                    if [ $i == '9999999999' ]; then
                        echo -en '×,' >>$result
                    elif [ $i == $m ]; then
                        echo $i | bc -l | xargs printf "*%.1f," >>$result
                    elif [ $i == $secm ]; then
                        echo $i | bc -l | xargs printf "^%.1f," >>$result
                    else
                        echo $i | bc -l | xargs printf "%.1f," >>$result
                    fi
                done
                # echo -en "|," >>$result
            done
            echo >>$result
        done
        cat $result
    }
    get_results

get_results_dense() {
    result=results.out
    rm $result
    echo -en "," >>$result
    WORD_COUNT=$(echo "$solutions" | wc -w)
    for k in $krange; do
        echo -en "**k=$k**," >>$result
        for ((i = 1; i < $WORD_COUNT; i++)); do
            echo -en "," >>$result
        done
        # echo -en "|," >>$result
    done
    echo >>$result

    echo -en "datasets," >>$result
    for k in $krange; do
        for sol in $solutions; do
            echo -en "${sol#*-}," >>$result
        done
        # echo -en "|," >>$result
    done
    echo >>$result

    for fn in $datasets; do
        echo -en "$fn," >>$result
        for k in $krange; do

            line=()
            outfile=''
            for sol in $solutions; do
                outfile=$fn-$sol-$k.out
                op=$(grep "n_mkp" $outfile)
                op=($op)
                if [ -z "${op}" ]; then
                    echo -en "×,×,×,×," >>$result
                else
                    echo -en "${op[-7]},${op[-5]},${op[-3]},${op[-1]}," >>$result
                fi
            done
            # echo -en "|," >>$result
        done
        echo >>$result
    done
    cat $result
}
get_results_dense

get_kpsize() {
    # solutions='kplex-full kplex-doubt kPlexS Maple'
    result=kpsize.out
    rm $result
    # for k in $krange; do
    #     echo -en "**** k=$k ****,,," >>$result
    # done
    echo -en "datasets," >>$result

    for k in $krange; do
        echo -en "**k=$k**," >>$result
        for sol in $solutions; do
            echo -en "${sol#*-}," >>$result
        done
    done

    echo >>$result

    for fn in $datasets; do
        echo -en "$fn,|," >>$result
        for k in $krange; do
            for sol in $solutions; do
                outfile=$sol-$k.out
                op=$(grep $fn $outfile)
                if [ -z "${op}" ]; then
                    echo -en 'x,' >>$result
                else
                    op=($op)
                    echo -en "${op[-5]}," >>$result
                fi
            done
            echo -en "|," >>$result
        done
        echo >>$result
    done
    cat $result
}

get_kpsize() {
    # solutions='kplex-full kplex-doubt kPlexS Maple'
    result=kpsize.out
    rm $result
    # for k in $krange; do
    #     echo -en "**** k=$k ****,,," >>$result
    # done
    echo -en "datasets," >>$result

    for k in $krange; do
        echo -en "**k=$k**," >>$result
        for sol in $solutions; do
            echo -en "${sol#*-}," >>$result
        done
    done

    echo >>$result

    for fn in $datasets; do
        echo -en "$fn," >>$result
        for k in $krange; do
            for sol in $solutions; do
                outfile=$sol-$k.out
                op=$(grep $fn $outfile)
                if [ -z "${op}" ]; then
                    echo -en 'x,' >>$result
                else
                    op=($op)
                    echo -en "${op[-7]}," >>$result
                fi
            done
            echo -en "|," >>$result
        done
