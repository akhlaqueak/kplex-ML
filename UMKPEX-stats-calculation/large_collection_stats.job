#!/usr/bin/env bash
#SBATCH --job-name=serial1
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

######################################
# Config
######################################
LOG="stats-filtered"
TASKFILE="configs.txt"     # one task per line: seq prog ds k [args...]

rm -f output.txt

echo "Job started at $(date)"
echo "SLURM job id: ${SLURM_JOB_ID:-local}"

export LOG TASKFILE

######################################
# Exit if no tasks
######################################
if [[ ! -s "$TASKFILE" ]]; then
    echo "No tasks in $TASKFILE. Exiting."
    exit 0
fi

######################################
# Parallel execution
######################################
srun --label bash -c '
set -uo pipefail

# 🔑 CRITICAL: ensure correct working directory
cd "$SLURM_SUBMIT_DIR" || exit 1

rank=${SLURM_PROCID:-0}
nworkers=${SLURM_NTASKS:-1}

logdir="$LOG"
taskfile="$TASKFILE"

mkdir -p "$logdir"

rank_out="${logdir}/output.${rank}.txt"
: > "$rank_out"

sed -n "$((rank+1))~$nworkers p" "$taskfile" |
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue

    echo "[Rank $rank] $line" >> "$rank_out"

    # Parse: seq + rest of command
    IFS= read -r seq rest <<< "$line"
    seq=${seq:-0}
    [[ -z "${rest:-}" ]] && continue

    # Split command into argv
    read -r -a cmd_array <<< "$rest"

    outfile="${logdir}/${rest// /_}.txt"

    # Run command (this WILL create outfile)
    ./stats "${cmd_array[@]}" > "$outfile" 2>&1 || true

    # Extract STATS, prepend seq
    awk -v seq="$seq" "
        /STATS:/ {
            \$1=\"\";
            sub(/^ /,\"\");
            printf \"%s %s\\n\", seq, \$0;
            found=1;
            exit
        }
        END {
            if (!found)
                printf \"%s 0 0 0 0 0 []\\n\", seq
        }
    " "$outfile" >> "$rank_out"

done
' || true

echo "srun completed."
echo "Finished at $(date)"
