#!/usr/bin/env bash
#SBATCH --job-name=serial1
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

######################################
# Config
######################################
LOG="stats-filtered"
TASKFILE="configs.txt"
STATS_BIN="$SLURM_SUBMIT_DIR/stats"
FINAL_OUT="output.txt"

rm -rf "$LOG" "$FINAL_OUT"
mkdir -p "$LOG"

export LOG TASKFILE STATS_BIN

if [[ ! -s "$TASKFILE" ]]; then
    echo "No tasks in $TASKFILE"
    exit 0
fi

######################################
# Parallel execution
######################################
srun --label bash -c '
set -o pipefail
cd "$SLURM_SUBMIT_DIR" || exit 1

rank=${SLURM_PROCID:-0}
nworkers=${SLURM_NTASKS:-1}

rank_out="$LOG/output.${rank}.txt"
: > "$rank_out"

sed -n "$((rank+1))~$nworkers p" "$TASKFILE" |
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue

    # --- robust parsing ---
    seq=${line%%[[:space:]]*}
    rest=${line#*[[:space:]]}
    [[ -z "$rest" ]] && continue

    # Per-task outfile
    base=$(basename "${rest%%[[:space:]]*}")
    outfile="$LOG/${base}_${seq}.txt"

    # Run stats
    set -- $rest
    "$STATS_BIN" "$@" > "$outfile" 2>&1

    # Extract STATS (double-quoted awk — SAFE)
    awk -v seq="$seq" "
        /STATS:/ {
            \$1=\"\";
            sub(/^ /,\"\");
            printf \"%s %s\\n\", seq, \$0;
            found=1;
            exit
        }
        END {
            if (!found)
                printf \"%s 0 0 0 0 0 []\\n\", seq
        }
    " \"$outfile\" >> \"$rank_out\"

done
'

######################################
# Consolidate final output
######################################
echo "Consolidating results..."

grep -h '^[0-9]' "$LOG"/output.*.txt \
    | sort -n \
    > "$FINAL_OUT"

echo "Final output written to $FINAL_OUT"
echo "Job finished at $(date)"


while read -r seq ds k; do 
f=$(basename $ds)
grep "^STATS" stats-filtered/${f}_$seq.txt >> output.txt
done < configs.txt