#!/usr/bin/env bash
#SBATCH --job-name=serial1
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

LOG="stats-filtered"
TASKFILE="configs.txt"
STATS_BIN="$SLURM_SUBMIT_DIR/stats"

rm -f output.txt
mkdir -p "$LOG"

export LOG TASKFILE STATS_BIN

if [[ ! -s "$TASKFILE" ]]; then
    echo "No tasks in $TASKFILE. Exiting."
    exit 0
fi

srun --label bash -c '
set -uo pipefail
cd "$SLURM_SUBMIT_DIR" || exit 1

rank=${SLURM_PROCID:-0}
nworkers=${SLURM_NTASKS:-1}

mkdir -p "$LOG"
rank_out="$LOG/output.${rank}.txt"
: > "$rank_out"

sed -n "$((rank+1))~$nworkers p" "$TASKFILE" |
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue

    echo "[Rank $rank] $line" >> "$rank_out"

    IFS= read -r seq rest <<< "$line"
    seq=${seq:-0}
    [[ -z "${rest:-}" ]] && continue

    base=$(basename "${rest%% *}")
    outfile="$LOG/${base}_${seq}.txt"

    # 🔑 SAFE execution (no arrays, no early exit)
    set -- $rest
    echo "$STATS_BIN" "$@" > "$outfile"

    awk -v seq="$seq" "
        /STATS:/ {
            \$1=\"\";
            sub(/^ /,\"\");
            printf \"%s %s\\n\", seq, \$0;
            found=1;
            exit
        }
        END {
            if (!found)
                printf \"%s 0 0 0 0 0 []\\n\", seq
        }
    " "$outfile" >> "$rank_out"
done
' || true
