#!/usr/bin/env bash
#SBATCH --job-name=serial1
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

LOG="stats-filtered"
TASKFILE="configs.txt"
STATS_BIN="$SLURM_SUBMIT_DIR/stats"

rm -rf "$LOG"
mkdir -p "$LOG"

export LOG TASKFILE STATS_BIN

if [[ ! -s "$TASKFILE" ]]; then
    echo "No tasks in $TASKFILE"
    exit 0
fi

srun --label bash -c '
set -o pipefail
cd "$SLURM_SUBMIT_DIR" || exit 1

rank=${SLURM_PROCID:-0}
nworkers=${SLURM_NTASKS:-1}

rank_out="$LOG/output.${rank}.txt"
: > "$rank_out"

sed -n "$((rank+1))~$nworkers p" "$TASKFILE" |
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue

    echo "[Rank $rank] LINE: $line" >> "$rank_out"

    # ✅ CORRECT parsing (whitespace-safe)
    seq=${line%%[[:space:]]*}
    rest=${line#*[[:space:]]}

    echo "[Rank $rank] SEQ=$seq REST=$rest" >> "$rank_out"

    [[ -z "$rest" ]] && continue

    base=$(basename "${rest%%[[:space:]]*}")
    outfile="$LOG/${base}_${seq}.txt"

    # Execute stats
    set -- $rest
    "$STATS_BIN" "$@" > "$outfile" 2>&1
    rc=$?

    echo "[Rank $rank] stats exit code=$rc" >> "$rank_out"
done
'

echo "Job finished"
