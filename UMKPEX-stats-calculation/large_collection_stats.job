#!/usr/bin/env bash
#SBATCH --job-name=serial1
#SBATCH --ntasks=192
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=10G
#SBATCH --partition=medium
#SBATCH --time=12:00:00
#SBATCH --no-requeue
#SBATCH --output=%x.out
#SBATCH --error=%x.err

set -euo pipefail

######################################
# Config
######################################
LOG="stats-filtered"
TASKFILE="configs.txt"     # one task per line: seq prog ds k [args...]
TIME="5m"

mkdir -p "$LOG"
rm -f output.txt

echo "Job started at $(date)"
echo "SLURM job id: ${SLURM_JOB_ID:-local}"

export TASKFILE LOG TIME

######################################
# Exit if no tasks
######################################
if [[ ! -s "$TASKFILE" ]]; then
    echo "No tasks in $TASKFILE. Exiting."
    exit 0
fi

######################################
# Parallel execution
######################################
srun --label bash -c '
set -uo pipefail

rank=${SLURM_PROCID:-0}
nworkers=${SLURM_NTASKS:-1}

taskfile="$TASKFILE"
logdir="$LOG"
time_limit="$TIME"

# Minimal sanitize: ONLY replace spaces with underscores
sanitize() {
    local s="$1"
    printf "%s" "${s// /_}"
}

rank_out="${logdir}/output.${rank}.txt"
: > "$rank_out"

sed -n "$((rank+1))~$nworkers p" "$taskfile" |
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue

    echo "[Rank $rank] $line" >> "$rank_out"

    # Parse: seq + rest of command
    IFS= read -r seq rest <<< "$line"
    seq=${seq:-0}

    fname=$(sanitize "$rest")
    outfile="${logdir}/${fname}.txt"

    timeout "$time_limit" ./stats "$rest" > "$outfile" 2>&1 || true

    awk -v seq="$seq" "
        /STATS:/ {
            \$1=\"\";
            sub(/^ /,\"\");
            printf \"%s %s\\n\", seq, \$0;
            found=1;
            exit
        }
        END {
            if (!found)
                printf \"%s 0 0 0 0 0 []\\n\", seq
        }
    " "$outfile" >> "$rank_out"

done
' || true

echo "srun completed."

######################################
# Merge outputs
######################################
shopt -s nullglob
files=("$LOG"/output.*.txt)

if (( ${#files[@]} )); then
    IFS=$'\n' sorted=( $(printf "%s\n" "${files[@]}" | sort -V) )
    for f in "${sorted[@]}"; do
        cat "$f" >> output.txt
    done
    rm -f "$LOG"/output.*.txt
fi
shopt -u nullglob

echo "Finished at $(date)"
